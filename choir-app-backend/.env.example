# =============================================================================
# Chorleiter Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your specific values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8088
ADDRESS=localhost
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL or SQLite)
# -----------------------------------------------------------------------------
# For PostgreSQL (production):
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chorleiter
DB_USER=chorleiter_user
DB_PASSWORD=your_secure_password_here

# For SQLite (local development/testing):
# DB_DIALECT=sqlite
# DB_NAME=./database.sqlite

# Log every SQL statement (verbose, slows down startup) - only enable for debugging
# DB_LOGGING=true

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# CRITICAL: Use a strong, random secret in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@nak-chorleiter.de

# -----------------------------------------------------------------------------
# System Configuration
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_EMAIL=admin@example.com
FRONTEND_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# Push Notifications (PWA - optional)
# -----------------------------------------------------------------------------
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your_email@example.com
PUSH_MAX_SUBSCRIPTIONS_PER_USER=10

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# MCP server and choir API tokens
# -----------------------------------------------------------------------------
# Set MCP_ENABLED=false to remove the /mcp endpoint entirely.
MCP_ENABLED=true
# HMAC secret for pseudonymous person references in MCP responses.
# Falls back to JWT_SECRET if unset; use 32+ random characters.
MCP_PERSON_REF_SECRET=
# Token lifetime and quantity limits
API_TOKEN_MAX_DAYS=90
API_TOKEN_MAX_PER_CHOIR=5
# Expiry warning mail
API_TOKEN_EXPIRY_WARN_DAYS=7
API_TOKEN_EXPIRY_CHECK_INTERVAL_MS=3600000
# Per-token request quotas
MCP_RATE_LIMIT_PER_MIN=60
MCP_RATE_LIMIT_PER_DAY=5000
# Global kill switch for all MCP write tools
MCP_WRITE_ENABLED=true
MCP_WRITE_QUOTA_PER_DAY=20
MCP_CONFIRMATION_TTL_SEC=300
# Public origin used in OAuth metadata and the WWW-Authenticate challenge.
# Must match the address MCP clients use, e.g. https://nak-chorleiter.de
PUBLIC_BASE_URL=
# OAuth facade for MCP clients that cannot send a static bearer token
OAUTH_CODE_TTL_SEC=600
OAUTH_REFRESH_TTL_DAYS=365

# -----------------------------------------------------------------------------
# Debug Flags (development only)
# -----------------------------------------------------------------------------
DEBUG_AUTH=false
DEBUG_CSRF=false

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=Europe/Berlin
